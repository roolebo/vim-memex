#!/usr/bin/env bash
#
# test/run: tests of vim-memex, offline.
#
# Each test runs its own Vim in a private tmux server, in a git
# repository of its own. memex is test/fake-memex, which serves the
# threads of change 1234 from test/data.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ROOT=$(dirname "$CURDIR")
DIR=$(realpath "$(mktemp -d)")
FAILED=0

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

t() {
  tmux -L "vim-memex-test-$$" "$@"
}

cleanup() {
  t kill-server 2> /dev/null || true
  rm -rf "$DIR"
}

# Start the editor in the directory WD: vim ARGS, wait until it has
# started
editor() {
  local i
  t kill-server 2> /dev/null || true
  t new-session -d -x 120 -y 30 -c "$1" vim -n -N -u NONE -i NONE \
    --servername "$SERVER" --cmd "set rtp^=$ROOT hidden" \
    --cmd "source $CURDIR/helpers.vim" -c 'runtime plugin/memex.vim' \
    "${@:2}"
  for i in $(seq 50); do
    [ "$(expr 'v:vim_did_enter' 2> /dev/null)" == 1 ] && return
    sleep 0.1
  done
  die "Vim didn't start: $*"
}

expr() {
  vim --servername "$SERVER" --remote-expr "$1"
}

# Type keys as the human, then give Vim time to handle them
keys() {
  t send-keys "$@"
  sleep 0.3
}

# Wait until Vim's EXPR is VALUE, for memex to finish
wait_for() {
  local i
  for i in $(seq 50); do
    [ "$(expr "$1")" == "$2" ] && return
    sleep 0.1
  done
}

# Run :MemexThreads ARGS and wait for the quickfix list
threads() {
  keys ":MemexThreads$1" Enter
  wait_for 'getqflist({"title": 1}).title' 'memex: Fix the lock'
}

# The screen's last line
bottom_line() {
  t capture-pane -p | tail -1
}

messages() {
  expr 'execute("messages")'
}

# The calls of memex, without the ones that read threads
calls() {
  grep -Ev '^discussion (locate|change|threads) ' "$MEMEX_FAKE/log" || true
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ $2 == *"$3"* ]] && return
  echo "# $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

check_lacks() {
  [[ $2 != *"$3"* ]] && return
  echo "# $1: '$2' has '$3'"
  FAILED=$((FAILED + 1))
}

test_threads_head() {
  editor "$REPO"
  threads
  check log "$(cat "$MEMEX_FAKE/log")" "$(printf '%s\n' \
    "discussion locate $(git -C "$REPO" rev-parse HEAD)" \
    'discussion threads 1234')"
  check quickfix "$(expr 'Qf()')" "$(printf '%s\n' \
    'src/a.c:2:Jane Reviewer: Leaks the lock. (+1)' \
    'src/a.c:1:[base] Jane Reviewer: Was this needed?' \
    'src/b.c:1:Bob Builder: Rename the file.' \
    ':0:[commit message] Jane Reviewer: Say why.' \
    ':0:[change] Bob Builder: Looks good overall.' \
    'src/a.c:5:Bob Builder: Old remark. [patch set 1]' \
    'src/b.c:2:[draft] Jane Reviewer: Use a macro. (+1)')"
  check end "$(expr 'getqflist()[0].end_lnum')" 3
  check_has message "$(bottom_line)" '7 threads on change 1234'
}

test_threads_change() {
  editor "$REPO"
  threads ' 1234'
  check log "$(cat "$MEMEX_FAKE/log")" "$(printf '%s\n' \
    'discussion change 1234' 'discussion threads 1234')"
  check entries "$(expr 'len(getqflist())')" 7
}

test_threads_resolved() {
  editor "$REPO"
  threads '!'
  check entries "$(expr 'len(getqflist())')" 8
  check resolved "$(expr 'getqflist()[5].text')" \
    'Jane Reviewer: Typo. [resolved]'
}

test_threads_not_a_working_copy() {
  editor "$TEST_DIR"
  keys :MemexThreads Enter
  check_has warning "$(messages)" 'vim-memex: not in a git working copy'
  check log "$(cat "$MEMEX_FAKE/log" 2> /dev/null)" ''
}

test_threads_error() {
  editor "$REPO"
  keys ':MemexThreads 99' Enter
  wait_for 'execute("messages") =~ "No change"' 1
  check_has warning "$(messages)" 'vim-memex: No change 99'
  echo threads > "$MEMEX_FAKE/fail"
  keys :MemexThreads Enter
  wait_for 'execute("messages") =~ "threads failed"' 1
  check_has warning "$(messages)" 'vim-memex: threads failed'
  check quickfix "$(expr 'len(getqflist())')" 0
}

# Not after a base line nor after a resolved thread's
test_after_lines() {
  editor "$REPO" src/a.c
  threads
  check 1 "$(expr 'After("src/a.c", 1)')" ''
  check 2 "$(expr 'After("src/a.c", 2)')" \
    '  Jane Reviewer: Leaks the lock. (+1)'
  check 4 "$(expr 'After("src/a.c", 4)')" ''
  check 5 "$(expr 'After("src/a.c", 5)')" \
    '  Bob Builder: Old remark. [patch set 1]'
}

test_after_lines_opened_later() {
  editor "$REPO"
  threads
  keys ':edit src/b.c' Enter
  check 1 "$(expr 'After("src/b.c", 1)')" '  Bob Builder: Rename the file.'
  check 2 "$(expr 'After("src/b.c", 2)')" \
    '  [draft] Jane Reviewer: Use a macro. (+1)'
}

# The file opened through a symbolic link to the repository
test_after_lines_symlink() {
  ln -s repo "$TEST_DIR/link"
  editor "$TEST_DIR" link/src/a.c
  threads
  check 2 "$(expr 'After("link/src/a.c", 2)')" \
    '  Jane Reviewer: Leaks the lock. (+1)'
  keys 2G :MemexReply Enter
  check buffer "$(expr 'bufname()')" memex://reply/t1
}

# The entry at the cursor in the quickfix window, not the current one
test_reply_from_quickfix() {
  editor "$REPO"
  threads
  keys :copen Enter 3G ':MemexReply' Enter
  check buffer "$(expr 'bufname()')" memex://reply/t3
  check status "$(expr '&l:statusline')" \
    'memex reply to Bob Builder: Rename the file.'
}

test_reply_from_line() {
  editor "$REPO" src/a.c
  threads
  keys 2G :MemexReply Enter
  check buffer "$(expr 'bufname()')" memex://reply/t1
  check status "$(expr '&l:statusline')" \
    'memex reply to Bob Builder: Which path?'
}

test_reply_no_thread() {
  editor "$REPO" src/a.c
  threads
  keys 3G :MemexReply Enter
  check buffer "$(expr 'bufname()')" src/a.c
  check_has warning "$(messages)" 'vim-memex: no thread here'
}

# An entry of another role, not a thread
test_reply_issue() {
  editor "$REPO"
  threads
  keys ':MemexIssues x' Enter
  wait_for 'getqflist({"title": 1}).title' 'memex issues: x'
  keys :copen Enter :MemexReply Enter
  check_has warning "$(messages)" 'vim-memex: no thread here'
}

# The second write replaces the first draft
test_reply_write() {
  editor "$REPO" src/a.c
  threads
  keys 2G :MemexReply Enter i 'The unlock path.' Escape :w Enter
  wait_for '&modified' 0
  check calls "$(calls)" \
    'discussion draft 1234 {"reply_to":"c2","text":"The unlock path."}'
  check_has message "$(bottom_line)" 'draft saved on change 1234'
  keys A ' Fixed.' Escape :w Enter
  wait_for '&modified' 0
  check calls "$(calls)" "$(printf '%s\n' \
    'discussion draft 1234 {"reply_to":"c2","text":"The unlock path."}' \
    'discussion discard 1234 d1' \
    'discussion draft 1234 {"reply_to":"c2","text":"The unlock path. Fixed."}')"
}

# Opening the reply again keeps the draft in progress
test_reply_twice() {
  editor "$REPO" src/a.c
  threads
  keys 2G :MemexReply Enter i 'Sure.' Escape :w Enter
  wait_for '&modified' 0
  keys C-w p :MemexReply Enter A ' Done.' Escape :w Enter
  wait_for '&modified' 0
  check calls "$(calls)" "$(printf '%s\n' \
    'discussion draft 1234 {"reply_to":"c2","text":"Sure."}' \
    'discussion discard 1234 d1' \
    'discussion draft 1234 {"reply_to":"c2","text":"Sure. Done."}')"
}

test_reply_empty() {
  editor "$REPO" src/a.c
  threads
  keys 2G :MemexReply Enter :w Enter
  check_has warning "$(messages)" 'vim-memex: empty reply, nothing drafted'
  check calls "$(calls)" ''
}

test_reply_error() {
  editor "$REPO" src/a.c
  threads
  echo draft > "$MEMEX_FAKE/fail"
  keys 2G :MemexReply Enter i 'Sure.' Escape :w Enter
  wait_for 'execute("messages") =~ "draft failed"' 1
  check_has warning "$(messages)" 'vim-memex: draft failed'
  check modified "$(expr '&modified')" 1
}

test_drafts() {
  editor "$REPO" src/a.c
  threads
  keys 2G :MemexReply Enter i 'Sure.' Escape :w Enter
  wait_for '&modified' 0
  keys :MemexDrafts Enter
  wait_for 'getqflist({"title": 1}).title' 'memex drafts: Fix the lock'
  check quickfix "$(expr 'Qf()')" ':0:[change] [draft] Me: Sure.'
  check_has message "$(bottom_line)" '1 drafts on change 1234'
}

test_drafts_before_threads() {
  editor "$REPO"
  keys :MemexDrafts Enter
  check_has warning "$(messages)" 'vim-memex: run :MemexThreads first'
}

test_drafts_unsupported() {
  editor "$REPO"
  threads
  echo drafts > "$MEMEX_FAKE/unsupported"
  keys :MemexDrafts Enter
  wait_for 'execute("messages") =~ "not supported"' 1
  check_has warning "$(messages)" \
    'vim-memex: not supported by the bound adapter'
  check quickfix "$(expr 'getqflist({"title": 1}).title')" \
    'memex: Fix the lock'
}

test_publish() {
  editor "$REPO"
  threads
  keys :MemexPublish Enter
  keys y
  sleep 0.5
  check calls "$(calls)" 'discussion publish 1234 {}'
  check_has message "$(bottom_line)" 'vim-memex: published on change 1234'
}

test_publish_declined() {
  editor "$REPO"
  threads
  keys :MemexPublish Enter
  keys n
  keys :MemexPublish Enter
  keys Enter
  check calls "$(calls)" ''
}

test_publish_error() {
  editor "$REPO"
  threads
  echo publish > "$MEMEX_FAKE/fail"
  keys :MemexPublish Enter
  keys y
  wait_for 'execute("messages") =~ "publish failed"' 1
  check_has warning "$(messages)" 'vim-memex: publish failed'
  check_lacks message "$(messages)" 'published on'
}

# Run :MemexIssue ARGS and wait for the issue's buffer, ISSUE
issue() {
  keys ":MemexIssue$1" Enter
  wait_for 'bufname()' "memex://issue/$2"
}

# The current buffer's lines
lines() {
  expr 'join(getline(1, "$"), "\n")'
}

test_issue() {
  editor "$REPO"
  issue ' BUG-1' BUG-1
  check log "$(cat "$MEMEX_FAKE/log")" 'tracker issue BUG-1'
  check buffer "$(lines)" "$(printf '%s\n' \
    '# BUG-1: Lock leaks on the error path' '' \
    '- status: Open' '- assignee: Jane Reviewer' \
    '- url: https://issues.example.org/BUG-1' '' \
    'The write fails and the lock stays held.' '' 'Seen twice.' '' \
    '## Bob Builder, 2026-10-20T10:00:00Z' '' 'Seen in the nightly run.' '' \
    '## Jane Reviewer, 2026-10-21T09:00:00Z' '' 'Fix under review.')"
  check filetype "$(expr '&filetype')" markdown
  check modifiable "$(expr '&modifiable')" 0
  # Again: the same window, read anew
  keys C-w p
  issue ' BUG-1' BUG-1
  check windows "$(expr 'winnr("$")')" 2
  check lines "$(expr 'line("$")')" 17
}

test_issue_error() {
  editor "$REPO"
  keys ':MemexIssue BUG-9' Enter
  wait_for 'execute("messages") =~ "No issue"' 1
  check_has warning "$(messages)" 'vim-memex: No issue BUG-9'
  check buffer "$(expr 'bufname()')" ''
}

test_issue_no_entry() {
  editor "$REPO"
  keys :MemexIssue Enter
  check_has warning "$(messages)" 'vim-memex: no issue here'
}

# The query goes on stdin; an entry opens its issue
test_issues() {
  editor "$REPO"
  keys ':MemexIssues assignee = me' Enter
  wait_for 'getqflist({"title": 1}).title' 'memex issues: assignee = me'
  check log "$(cat "$MEMEX_FAKE/log")" 'tracker search assignee = me'
  check quickfix "$(expr 'Qf()')" "$(printf '%s\n' \
    ':0:BUG-1 Open: Lock leaks on the error path' \
    ':0:BUG-2 Closed: Typo in the manual')"
  check_has message "$(bottom_line)" 'vim-memex: 2 issues'
  keys :copen Enter 2G :MemexIssue Enter
  wait_for 'bufname()' memex://issue/BUG-2
  check assignee "$(expr 'getline(4)')" '- assignee: nobody'
}

test_comment() {
  editor "$REPO"
  keys ':MemexComment BUG-1' Enter
  check buffer "$(expr 'bufname()')" memex://comment/BUG-1
  keys i 'Fixed in 1234.' Escape :w Enter
  keys y
  wait_for '&modified' 0
  check log "$(cat "$MEMEX_FAKE/log")" 'tracker comment BUG-1 Fixed in 1234.'
  check_has message "$(bottom_line)" 'comment sent to issue BUG-1'
}

test_comment_declined() {
  editor "$REPO"
  keys ':MemexComment BUG-1' Enter i 'Fixed.' Escape :w Enter
  keys n
  check modified "$(expr '&modified')" 1
  keys :w Enter
  keys Enter
  check log "$(cat "$MEMEX_FAKE/log" 2> /dev/null)" ''
}

test_comment_empty() {
  editor "$REPO"
  keys ':MemexComment BUG-1' Enter :w Enter
  check_has warning "$(messages)" 'vim-memex: empty comment, nothing sent'
  check log "$(cat "$MEMEX_FAKE/log" 2> /dev/null)" ''
}

test_comment_error() {
  editor "$REPO"
  keys ':MemexComment BUG-9' Enter i 'Fixed.' Escape :w Enter
  keys y
  wait_for 'execute("messages") =~ "No issue"' 1
  check_has warning "$(messages)" 'vim-memex: No issue BUG-9'
  check modified "$(expr '&modified')" 1
}

test_transition() {
  editor "$REPO"
  keys ':MemexTransition BUG-1 In Progress' Enter
  keys y
  wait_for 'execute("messages") =~ "moved to"' 1
  check log "$(cat "$MEMEX_FAKE/log")" 'tracker transition BUG-1 In Progress'
  check_has message "$(bottom_line)" 'issue BUG-1 moved to In Progress'
}

test_transition_declined() {
  editor "$REPO"
  keys ':MemexTransition BUG-1 Closed' Enter
  keys n
  keys ':MemexTransition BUG-1' Enter
  check_has warning "$(messages)" 'vim-memex: give the status'
  check log "$(cat "$MEMEX_FAKE/log" 2> /dev/null)" ''
}

# Run :MemexRuns ARGS and wait for the quickfix list
runs() {
  local commit=${1# }
  keys ":MemexRuns$1" Enter
  wait_for 'getqflist({"title": 1}).title' "memex runs: ${commit:-HEAD}"
}

test_runs() {
  editor "$REPO"
  runs
  check log "$(cat "$MEMEX_FAKE/log")" \
    "ci runs $(git -C "$REPO" rev-parse HEAD)"
  check quickfix "$(expr 'Qf()')" "$(printf '%s\n' \
    ':0:fail x86_64/el9 2026-10-20T15:00:00Z' ':0:running build')"
  check_has message "$(bottom_line)" 'vim-memex: 2 runs'
}

test_runs_commit() {
  editor "$REPO"
  runs ' HEAD'
  check log "$(cat "$MEMEX_FAKE/log")" \
    "ci runs $(git -C "$REPO" rev-parse HEAD)"
  keys ':MemexRuns nothing' Enter
  wait_for 'execute("messages") =~ "single revision"' 1
  check_has warning "$(messages)" 'Needed a single revision'
  check calls "$(wc -l < "$MEMEX_FAKE/log")" 1
}

# From the entry at the cursor in the quickfix window
test_suites() {
  editor "$REPO"
  runs
  keys :copen Enter :MemexSuites Enter
  wait_for 'getqflist({"title": 1}).title' 'memex suites: run r1'
  check quickfix "$(expr 'Qf()')" "$(printf '%s\n' \
    ':0:fail sanity (2 fail, 412 pass, 9 skip)' ':0:pass build')"
  keys :colder Enter 2G :MemexSuites Enter
  wait_for 'getqflist({"title": 1}).title' 'memex suites: run r2'
  check quickfix "$(expr 'Qf()')" ''
}

test_suites_no_run() {
  editor "$REPO"
  keys ':MemexIssues x' Enter
  wait_for 'getqflist({"title": 1}).title' 'memex issues: x'
  keys :MemexSuites Enter
  check_has warning "$(messages)" 'vim-memex: no run here'
}

# From the current entry, failures first
test_tests() {
  editor "$REPO"
  runs
  keys :MemexSuites Enter
  wait_for 'getqflist({"title": 1}).title' 'memex suites: run r1'
  keys :MemexTests Enter
  wait_for 'getqflist({"title": 1}).title' 'memex tests: sanity'
  check log "$(grep -v '^ci runs' "$MEMEX_FAKE/log")" \
    "$(printf '%s\n' 'ci suites r1' 'ci tests s1')"
  check quickfix "$(expr 'Qf()')" "$(printf '%s\n' \
    ':0:fail test_51b: dd failed: No space left on device' \
    ':0:timeout test_60' ':0:pass test_1' ':0:skip test_52')"
}

test_logs() {
  editor "$REPO"
  runs
  keys :MemexLogs Enter
  wait_for 'getqflist({"title": 1}).title' 'memex logs: run r1'
  check quickfix "$(expr 'Qf()')" \
    ':0:console.log: https://ci.example.org/runs/r1/console.log'
  keys :colder Enter :MemexSuites Enter
  wait_for 'getqflist({"title": 1}).title' 'memex suites: run r1'
  keys :MemexTests Enter
  wait_for 'getqflist({"title": 1}).title' 'memex tests: sanity'
  keys :MemexLogs Enter
  wait_for 'getqflist({"title": 1}).title' 'memex logs: test test_51b'
  check quickfix "$(expr 'Qf()')" \
    ':0:test_51b.log: https://ci.example.org/tests/t11/test_51b.log'
}

test_retest() {
  editor "$REPO"
  runs
  keys :MemexRetest Enter 'flaky node' Enter
  keys y
  wait_for 'execute("messages") =~ "retest of run"' 1
  check log "$(grep -v '^ci runs' "$MEMEX_FAKE/log")" \
    'ci retest r1 {"reason":"flaky node"}'
  check_has message "$(bottom_line)" 'vim-memex: retest of run r1 asked for'
}

test_retest_declined() {
  editor "$REPO"
  runs
  keys :MemexRetest Enter 'flaky node' Enter
  keys n
  keys :MemexRetest Enter Enter
  check_has warning "$(messages)" 'vim-memex: no reason given'
  check log "$(grep -v '^ci runs' "$MEMEX_FAKE/log")" ''
}

test_retest_unsupported() {
  editor "$REPO"
  runs
  echo retest > "$MEMEX_FAKE/unsupported"
  keys :MemexRetest Enter 'flaky node' Enter
  keys y
  wait_for 'execute("messages") =~ "not supported"' 1
  check_has warning "$(messages)" \
    'vim-memex: not supported by the bound adapter'
  check_lacks message "$(messages)" 'asked for'
}

# A repository with the files the threads are about
make_repo() {
  git init -q "$REPO"
  mkdir "$REPO/src"
  seq 6 > "$REPO/src/a.c"
  seq 3 > "$REPO/src/b.c"
  git -C "$REPO" add .
  git -C "$REPO" commit -qm 'Fix the lock'
}

run() {
  local failed=$FAILED
  TEST=$1
  TEST_DIR=$DIR/$1
  SERVER=$TEST_DIR/vim
  REPO=$TEST_DIR/repo
  MEMEX_FAKE=$TEST_DIR/memex
  mkdir -p "$MEMEX_FAKE"
  make_repo
  "$1"
  t kill-server 2> /dev/null || true
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v tmux > /dev/null || die "tmux is not installed"
command -v jq > /dev/null || die "jq is not installed"
vim --version | grep -q '+clientserver' || die "Vim lacks +clientserver"
trap cleanup EXIT
mkdir "$DIR/bin"
ln -s "$CURDIR/fake-memex" "$DIR/bin/memex"
export PATH=$DIR/bin:$PATH
export MEMEX_FAKE
# Commits in test repos don't depend on the user's git config
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
